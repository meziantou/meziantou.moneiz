<div>
    @foreach (var chart in charts)
    {
        <h2>@chart.Name</h2>
        <div class="chart">@((MarkupString)chart.Svg)</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Meziantou.Moneiz.Core.Analytics.BalanceHistory? Model { get; set; }

    private MoneizDisplaySettings displaySettings = new();
    private IReadOnlyList<BalanceHistoryChartData> charts = [];

    protected override async Task OnInitializedAsync()
    {
        displaySettings = await SettingsProvider.GetDisplaySettings();
    }

    protected override void OnParametersSet()
    {
        charts = BalanceHistoryChartBuilder.Build(Model, displaySettings);
    }
}
