@inject IJSRuntime JSRuntime

<button type="button" @onclick="e => visible = true" class="btn-link dropdown-toggle" popovertarget="@id" style="anchor-name: @anchor">@MenuText <i class="fas @MenuIcon"></i></button>
<nav class="dropdown-content" id="@id" popover="auto" style="position-anchor: @anchor" @ref="popover">
    @if (visible)
    {
        <ul @onclick="Hide">
            @ChildContent
        </ul>
    }
</nav>

@code {
    string id = "id-" + Guid.NewGuid().ToString("N");
    string anchor = "--anchor-" + Guid.NewGuid().ToString("N");
    bool visible = false;
    ElementReference popover;

    [Parameter]
    public string? MenuText { get; set; }

    [Parameter]
    public string MenuIcon { get; set; } = "fa-cog";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Clicking an item does not light-dismiss the popover, so close it explicitly
    private async Task Hide()
    {
        await JSRuntime.InvokeVoidAsync("MoneizHidePopover", popover);
    }
}