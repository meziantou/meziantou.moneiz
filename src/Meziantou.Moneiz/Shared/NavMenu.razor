@using System.Globalization
@inject DatabaseProvider DatabaseProvider
@inject NavigationManager NavigationManager
@implements IDisposable

<aside class="site-sidebar">
    <div class="widget-accounts">
        <Repeater Items="database?.VisibleAccounts">
            <RepeaterContainerTemplate>
                <ul>
                    @context
                </ul>
            </RepeaterContainerTemplate>

            <ItemTemplate Context="account">
                <li class="@(account.Id == selectedAccountId ? "active" : null)">
                    <div class="widget-accounts-summary">
                        <a href="accounts/@account.Id/transactions" title="@account">@account</a>
                        <Amount Value="@database!.GetTodayBalance(account)" Currency="@account.CurrencyIsoCode" />
                    </div>
                    @if (account.Id == selectedAccountId)
                    {
                        <div class="widget-accounts-details">
                            <div>
                                <span class="widget-accounts-details-title">On <UserDate Date="@Database.GetToday()" />:</span>
                                <Amount Value="@database.GetTodayBalance(account)" Currency="@account.CurrencyIsoCode" />
                            </div>
                            <div>
                                <span class="widget-accounts-details-title">All transactions:</span>
                                <Amount Value="@database.GetBalance(account)" Currency="@account.CurrencyIsoCode" />
                            </div>
                            <div>
                                <span class="widget-accounts-details-title">Reconciled transactions:</span>
                                <Amount Value="@database.GetReconciledBalance(account)" Currency="@account.CurrencyIsoCode" />
                            </div>
                            <div>
                                <span class="widget-accounts-details-title">Checked transactions:</span>
                                <Amount Value="@database.GetCheckedBalance(account)" Currency="@account.CurrencyIsoCode" />
                            </div>
                        </div>
                    }
                </li>
            </ItemTemplate>
        </Repeater>
    </div>
    <hr />
    <nav>
        <ul>
            <li><NavLink href="/transactions"><i class="fas fa-list"></i><span>All transactions</span></NavLink></li>
            <li><NavLink href="/accounts"><i class="fas fa-university"></i><span>My accounts</span></NavLink></li>
            <li><NavLink href="/categories"><i class="fas fa-tags"></i><span>My categories</span></NavLink></li>
            @if (displaySettings.ShowLabels)
            {
                <li><NavLink href="/labels"><i class="fas fa-tag"></i><span>My labels</span></NavLink></li>
            }
            <li><NavLink href="/payees"><i class="fas fa-users"></i><span>My payees</span></NavLink></li>
            <li><NavLink href="/scheduler"><i class="fas fa-calendar"></i><span>My scheduler</span></NavLink></li>
            <li><NavLink href="/analytics"><i class="fas fa-chart-line"></i><span>Analytics</span></NavLink></li>
            <li><NavLink href="/currencies"><i class="fas fa-dollar-sign"></i><span>Currencies</span></NavLink></li>
        </ul>
    </nav>
    <hr />
    <nav>
        <ApplicationVersion />
    </nav>
</aside>

@code {
    Database? database;
    MoneizDisplaySettings displaySettings = new();
    int? selectedAccountId;

    protected override async Task OnInitializedAsync()
    {
        selectedAccountId = GetSelectedAccountId();
        NavigationManager.LocationChanged += OnLocationChanged;
        DatabaseProvider.DatabaseChanged += OnDatabaseChanged;
        await LoadDatabase();
        displaySettings = await SettingsProvider.GetDisplaySettings();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        DatabaseProvider.DatabaseChanged -= OnDatabaseChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var accountId = GetSelectedAccountId();
        if (accountId != selectedAccountId)
        {
            selectedAccountId = accountId;
            StateHasChanged();
        }
    }

    private int? GetSelectedAccountId()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var index = path.AsSpan().IndexOfAny('?', '#');
        if (index >= 0)
        {
            path = path[..index];
        }

        if (path.Split('/') is ["accounts", var id, ..] && int.TryParse(id, NumberStyles.None, CultureInfo.InvariantCulture, out var accountId))
            return accountId;

        return null;
    }

    private void OnDatabaseChanged(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadDatabase();
            StateHasChanged();
        });

    }

    private async Task LoadDatabase()
    {
        database = await DatabaseProvider.GetDatabase();
    }
}